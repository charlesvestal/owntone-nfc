# deploy/config.yaml.example -> /etc/nfc-jukebox/config.yaml
owntone_url: http://127.0.0.1:3689
library_root: /srv/music
cards_file: /etc/nfc-jukebox/cards.yaml
outputs_file: /var/lib/nfc-jukebox/outputs.json
reader_device: "tty:AMA0:pn532"
# How long a card must be continuously unseen before the reader treats it as
# lifted. Measured in Spike 3 (2026-09-18): a 4-byte Mifare-Classic-style card
# sitting motionless reported 725 present/absent cycles in 25 seconds (median
# hold 0.008s) because the PN532's re-select for that technology keeps failing,
# while an NTAG213 held solid with a 35ms worst-case gap. Undebounced, the
# flicker became a play/pause storm at OwnTone and the box was silent while
# reporting "playing". 0.5 rides out any plausible run of missed reads and
# still stops the music within half a second of lifting a record.
# Raise it if an untested card still stutters; lower it if a lift feels laggy.
presence_debounce_s: 0.5
grace_period_s: 90.0
# Hour of the local day at which an unfinished album stops being resumable.
# Lifting a card pauses the record and putting it back picks up where it left
# off, however long it has been - but an album abandoned at midnight should be
# side one again the next morning, not the back half of side two. 3 is when
# nobody is listening.
# Note 0 means midnight, a real setting, so "off" has to be spelled out:
# set it to null (or "off") to keep the place until a different card is played.
resume_reset_hour: 3
web_port: 8080
# BCM pin wired to the PN532's RSTPDN (active-low reset). On the Waveshare
# PN532 HAT that pin is jumpered to D20. Restarting the service mid-read can
# leave the chip out of frame sync, after which every open fails with
# "Connection timed out" forever and the box looks healthy while never reading
# another card; pulsing this line low for a second is the only thing that
# clears it. The reader does that automatically after two failed opens in a
# row. Requires pinctrl (apt install raspi-utils) and permission to drive the
# pin; if either is missing it logs and keeps retrying.
# Set to null on a board with no RSTPDN jumper, or change it if yours is
# jumpered elsewhere.
reset_gpio: 20
